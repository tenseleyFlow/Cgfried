/* The compiler-owned __builtin_* set (Sprint 28).
 *
 * B(suffix, NAME, nargs, kind) — `suffix` is the spelling after
 * "__builtin_", NAME the SEMA_BUILTIN_* marker suffix, `nargs` the
 * required argument count (-1 = variadic/checked by hand), and `kind`
 * the result-type rule sema applies:
 *
 *   BK_VOID     void result
 *   BK_INT      int result
 *   BK_LONG     long result
 *   BK_SIZE     size_t result
 *   BK_VOIDP    void * result
 *   BK_DOUBLE   double result
 *   BK_FLOAT    float result
 *   BK_LLONG    long long result AND parameter
 *   BK_ARG0     same type as argument 0 (after promotion)
 *   BK_U16      uint16_t result AND parameter
 *   BK_U32      uint32_t result AND parameter
 *   BK_U64      uint64_t result AND parameter
 *   BK_SPECIAL  sema types it by hand
 *
 * BK_U* and BK_LLONG also constrain the ARGUMENT: these builtins have real
 * prototypes, so the argument converts as if by assignment. That is
 * observable — gcc warns "unsigned conversion from 'int' to 'short unsigned
 * int' changes value" for
 * __builtin_bswap16(0x11223344) and then swaps the TRUNCATED 0x3344.
 *
 * Names NOT in this table keep the parser's honest deferral. Adding a
 * row is the only way to make a builtin real — there is deliberately no
 * "accept anything __builtin_" fallback, because a silently-accepted
 * builtin that lowers to nothing is worse than a clean error. */

/* varargs (Sprint 19; the markers predate this table) */
B(va_start, VA_START, 2, BK_VOID)
B(va_end, VA_END, 1, BK_VOID)
B(va_copy, VA_COPY, 2, BK_VOID)

/* control flow / traps */
B(unreachable, UNREACHABLE, 0, BK_VOID)
B(trap, TRAP, 0, BK_VOID)

/* optimizer hints — honest no-ops in v0.1.0 (documented in the sprint
 * file and in --help's absence of any claim to the contrary) */
B(expect, EXPECT, 2, BK_ARG0)

/* memory */
B(alloca, ALLOCA, 1, BK_VOIDP)
B(memcpy, MEMCPY, 3, BK_VOIDP)
B(memmove, MEMMOVE, 3, BK_VOIDP)
B(memset, MEMSET, 3, BK_VOIDP)
B(memcmp, MEMCMP, 3, BK_INT)
B(strlen, STRLEN, 1, BK_SIZE)

/* integer library intrinsics */
B(llabs, LLABS, 1, BK_LLONG)

/* floating-point constants (Sprint 15 softfloat values, never host FP) */
B(huge_val, HUGE_VAL, 0, BK_DOUBLE)
B(huge_valf, HUGE_VALF, 0, BK_FLOAT)
B(inf, INF, 0, BK_DOUBLE)
B(inff, INFF, 0, BK_FLOAT)
B(nan, NAN, 1, BK_DOUBLE)
B(nanf, NANF, 1, BK_FLOAT)

/* byte swaps (glibc's <bits/byteswap.h> calls these directly once
 * __GNUC__ is defined). They lower to shifts, masks and ors -- see the
 * comment at their case in src/lower/expr.c for why there is no IR
 * opcode and what that costs. */
B(bswap16, BSWAP16, 1, BK_U16)
B(bswap32, BSWAP32, 1, BK_U32)
B(bswap64, BSWAP64, 1, BK_U64)

/* constant-expression queries */
B(constant_p, CONSTANT_P, 1, BK_INT)

/* __builtin_offsetof has its own AST form (its second operand is a
 * member DESIGNATOR, not an expression), so it is not in this table —
 * see AST_EXPR_OFFSETOF. */
