/* The compiler-owned __builtin_* set (Sprint 28).
 *
 * B(suffix, NAME, nargs, kind) — `suffix` is the spelling after
 * "__builtin_", NAME the SEMA_BUILTIN_* marker suffix, `nargs` the
 * required argument count (-1 = variadic/checked by hand), and `kind`
 * the result-type rule sema applies:
 *
 *   BK_VOID     void result
 *   BK_INT      int result
 *   BK_LONG     long result
 *   BK_SIZE     size_t result
 *   BK_VOIDP    void * result
 *   BK_CHARP    char * result
 *   BK_DOUBLE   double result
 *   BK_FLOAT    float result
 *   BK_LDOUBLE  long double result
 *   BK_LLONG    long long result AND parameter
 *   BK_ARG0     same type as argument 0 (after promotion)
 *   BK_U16      uint16_t result AND parameter
 *   BK_U32      uint32_t result AND parameter
 *   BK_U64      uint64_t result AND parameter
 *   BK_SPECIAL  sema types it by hand
 *
 * BK_U* and BK_LLONG also constrain the ARGUMENT: these builtins have real
 * prototypes, so the argument converts as if by assignment. That is
 * observable — gcc warns "unsigned conversion from 'int' to 'short unsigned
 * int' changes value" for
 * __builtin_bswap16(0x11223344) and then swaps the TRUNCATED 0x3344.
 *
 * Names NOT in this table keep the parser's honest deferral. Adding a
 * row is the only way to make a builtin real — there is deliberately no
 * "accept anything __builtin_" fallback, because a silently-accepted
 * builtin that lowers to nothing is worse than a clean error. */

/* varargs (Sprint 19; the markers predate this table) */
B(va_start, VA_START, -1, BK_VOID)
B(va_end, VA_END, 1, BK_VOID)
B(va_copy, VA_COPY, 2, BK_VOID)

/* control flow / traps */
B(abort, ABORT, 0, BK_VOID)
B(exit, EXIT, 1, BK_VOID)
B(unreachable, UNREACHABLE, 0, BK_VOID)
B(trap, TRAP, 0, BK_VOID)

/* optimizer hints — honest no-ops in v0.1.0 (documented in the sprint
 * file and in --help's absence of any claim to the contrary) */
B(expect, EXPECT, 2, BK_ARG0)
B(prefetch, PREFETCH, -1, BK_VOID)

/* memory */
B(malloc, MALLOC, 1, BK_VOIDP)
B(free, FREE, 1, BK_VOID)
B(alloca, ALLOCA, 1, BK_VOIDP)
B(memcpy, MEMCPY, 3, BK_VOIDP)
B(memmove, MEMMOVE, 3, BK_VOIDP)
B(memset, MEMSET, 3, BK_VOIDP)
B(memcmp, MEMCMP, 3, BK_INT)
B(strlen, STRLEN, 1, BK_SIZE)
B(strcmp, STRCMP, 2, BK_INT)
B(strcpy, STRCPY, 2, BK_CHARP)
B(stpcpy, STPCPY, 2, BK_CHARP)
B(strchr, STRCHR, 2, BK_CHARP)
B(strncpy, STRNCPY, 3, BK_CHARP)

/* character output */
B(puts, PUTS, 1, BK_INT)

/* formatted output.  Sema owns the fixed prototype prefix and applies the
 * default argument promotions to the anonymous suffix; lowering must then
 * use the target's full variadic-call ABI rather than the scalar libc
 * shortcut used above. */
B(printf, PRINTF, -1, BK_INT)
B(sprintf, SPRINTF, -1, BK_INT)
B(snprintf, SNPRINTF, -1, BK_INT)

/* integer library intrinsics */
B(abs, ABS, 1, BK_INT)
B(labs, LABS, 1, BK_LONG)
B(llabs, LLABS, 1, BK_LLONG)

/* type-generic checked arithmetic; the first two operands retain their
 * integer types and the third points at the exact result type */
B(add_overflow, ADD_OVERFLOW, 3, BK_SPECIAL)
B(sub_overflow, SUB_OVERFLOW, 3, BK_SPECIAL)
B(mul_overflow, MUL_OVERFLOW, 3, BK_SPECIAL)

/* fixed-prototype checked arithmetic; each spelling converts both operands
 * and the result pointer through its declared signed/unsigned int/long/long
 * long prototype before using the same infinite-precision operation */
B(sadd_overflow, SADD_OVERFLOW, 3, BK_SPECIAL)
B(saddl_overflow, SADDL_OVERFLOW, 3, BK_SPECIAL)
B(saddll_overflow, SADDLL_OVERFLOW, 3, BK_SPECIAL)
B(uadd_overflow, UADD_OVERFLOW, 3, BK_SPECIAL)
B(uaddl_overflow, UADDL_OVERFLOW, 3, BK_SPECIAL)
B(uaddll_overflow, UADDLL_OVERFLOW, 3, BK_SPECIAL)
B(ssub_overflow, SSUB_OVERFLOW, 3, BK_SPECIAL)
B(ssubl_overflow, SSUBL_OVERFLOW, 3, BK_SPECIAL)
B(ssubll_overflow, SSUBLL_OVERFLOW, 3, BK_SPECIAL)
B(usub_overflow, USUB_OVERFLOW, 3, BK_SPECIAL)
B(usubl_overflow, USUBL_OVERFLOW, 3, BK_SPECIAL)
B(usubll_overflow, USUBLL_OVERFLOW, 3, BK_SPECIAL)
B(smul_overflow, SMUL_OVERFLOW, 3, BK_SPECIAL)
B(smull_overflow, SMULL_OVERFLOW, 3, BK_SPECIAL)
B(smulll_overflow, SMULLL_OVERFLOW, 3, BK_SPECIAL)
B(umul_overflow, UMUL_OVERFLOW, 3, BK_SPECIAL)
B(umull_overflow, UMULL_OVERFLOW, 3, BK_SPECIAL)
B(umulll_overflow, UMULLL_OVERFLOW, 3, BK_SPECIAL)

/* type-generic checked arithmetic predicates; the third expression is
 * evaluated for side effects while its unpromoted type selects the range */
B(add_overflow_p, ADD_OVERFLOW_P, 3, BK_SPECIAL)
B(sub_overflow_p, SUB_OVERFLOW_P, 3, BK_SPECIAL)
B(mul_overflow_p, MUL_OVERFLOW_P, 3, BK_SPECIAL)

/* one-based least-significant-set-bit scans; zero maps to zero */
B(ffs, FFS, 1, BK_INT)
B(ffsl, FFSL, 1, BK_INT)
B(ffsll, FFSLL, 1, BK_INT)

/* zero-based leading/trailing-zero scans; a zero argument is undefined */
B(clz, CLZ, 1, BK_INT)
B(clzl, CLZL, 1, BK_INT)
B(clzll, CLZLL, 1, BK_INT)
B(ctz, CTZ, 1, BK_INT)
B(ctzl, CTZL, 1, BK_INT)
B(ctzll, CTZLL, 1, BK_INT)

/* redundant leading sign bits, excluding the sign bit itself */
B(clrsb, CLRSB, 1, BK_INT)
B(clrsbl, CLRSBL, 1, BK_INT)
B(clrsbll, CLRSBLL, 1, BK_INT)

/* population counts over the exact unsigned parameter width */
B(popcount, POPCOUNT, 1, BK_INT)
B(popcountl, POPCOUNTL, 1, BK_INT)
B(popcountll, POPCOUNTLL, 1, BK_INT)

/* parity of the population count over the exact unsigned parameter width */
B(parity, PARITY, 1, BK_INT)
B(parityl, PARITYL, 1, BK_INT)
B(parityll, PARITYLL, 1, BK_INT)

/* type-generic ordered/unordered real comparisons; sema performs the usual
 * arithmetic conversions and requires the resulting common type to be floating
 */
B(isunordered, ISUNORDERED, 2, BK_INT)
B(isless, ISLESS, 2, BK_INT)
B(islessequal, ISLESSEQUAL, 2, BK_INT)
B(isgreater, ISGREATER, 2, BK_INT)
B(isgreaterequal, ISGREATEREQUAL, 2, BK_INT)
B(islessgreater, ISLESSGREATER, 2, BK_INT)

/* floating-point constants (Sprint 15 softfloat values, never host FP) */
B(huge_val, HUGE_VAL, 0, BK_DOUBLE)
B(huge_valf, HUGE_VALF, 0, BK_FLOAT)
B(huge_vall, HUGE_VALL, 0, BK_LDOUBLE)
B(inf, INF, 0, BK_DOUBLE)
B(inff, INFF, 0, BK_FLOAT)
B(infl, INFL, 0, BK_LDOUBLE)
B(nan, NAN, 1, BK_DOUBLE)
B(nanf, NANF, 1, BK_FLOAT)
B(nanl, NANL, 1, BK_LDOUBLE)

/* type-generic floating classification; sema preserves the operand's real
 * type and rejects non-floating arguments */
B(isnan, ISNAN, 1, BK_SPECIAL)
B(isinf, ISINF, 1, BK_SPECIAL)
B(isfinite, ISFINITE, 1, BK_SPECIAL)
B(signbit, SIGNBIT, 1, BK_SPECIAL)

/* floating absolute value; each spelling has the corresponding real
 * prototype rather than the default argument promotions */
B(fabs, FABS, 1, BK_DOUBLE)
B(fabsf, FABSF, 1, BK_FLOAT)
B(fabsl, FABSL, 1, BK_LDOUBLE)

/* floating copy-sign; both operands convert through the exact declared
 * real prototype, and lowering preserves the first operand's payload */
B(copysign, COPYSIGN, 2, BK_DOUBLE)
B(copysignf, COPYSIGNF, 2, BK_FLOAT)
B(copysignl, COPYSIGNL, 2, BK_LDOUBLE)

/* byte swaps (glibc's <bits/byteswap.h> calls these directly once
 * __GNUC__ is defined). They lower to shifts, masks and ors -- see the
 * comment at their case in src/lower/expr.c for why there is no IR
 * opcode and what that costs. */
B(bswap16, BSWAP16, 1, BK_U16)
B(bswap32, BSWAP32, 1, BK_U32)
B(bswap64, BSWAP64, 1, BK_U64)

/* constant-expression queries */
B(constant_p, CONSTANT_P, 1, BK_INT)

/* __builtin_offsetof has its own AST form (its second operand is a
 * member DESIGNATOR, not an expression), so it is not in this table —
 * see AST_EXPR_OFFSETOF. */
