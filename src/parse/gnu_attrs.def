/* The GNU attribute table. One row per attribute, X-macro'd into the
 * classification switch. Sorted by name.
 *
 *   GA(name, class)
 *
 * THE CLASS IS DECIDED BY ONE QUESTION: what happens if we ignore it?
 *
 *   GA_IGNORE  Ignoring costs a diagnostic or a missed optimization, never
 *              a wrong answer. Accepted, warned under -Wattributes (gcc's
 *              own flag and default-on, so `-Wno-attributes` works the way
 *              a user expects).
 *
 *   GA_IMPLEMENTED  The semantics are real. The row exists so this table
 *              stays the whole truth about the attribute surface -- an
 *              implemented attribute left classified GA_UNSAFE would read as
 *              refused, and the tier doc would drift from the code.
 *
 *   GA_UNSAFE  Ignoring changes LAYOUT, LINKAGE or observable behaviour.
 *              Hard error until implemented. `transparent_union` ignored is
 *              the wrong parameter ABI; `gnu_inline` ignored decides whether
 *              a definition emits a symbol at all. Every one of those links
 *              and then misbehaves, which is the
 *              failure mode docs/gnu-extensions.md exists to prevent.
 *
 * A row moves from GA_UNSAFE to implemented when its semantics land, and
 * the same commit adds its row to the implemented table in
 * docs/gnu-extensions.md -- check_gnu_tiers.sh enforces the fixture.
 *
 * Attributes NOT listed here are unknown: accepted and warned, exactly as
 * gcc does, because a compiler that hard-errors on an attribute it has
 * never heard of cannot read next year's headers. */

/* --- safe to ignore: diagnostics and optimization hints ----------------- */
GA(access, GA_IGNORE)
GA(alloc_align, GA_IGNORE)
GA(alloc_size, GA_IGNORE)
GA(always_inline, GA_IMPLEMENTED)
GA(artificial, GA_IGNORE)
GA(cold, GA_IGNORE)
GA(const, GA_IGNORE)
GA(deprecated, GA_IMPLEMENTED)
GA(diagnose_if, GA_IGNORE)
GA(flatten, GA_IGNORE)
GA(format, GA_IMPLEMENTED)
GA(format_arg, GA_IGNORE)
GA(hot, GA_IGNORE)
GA(leaf, GA_IGNORE)
GA(malloc, GA_IGNORE)
GA(no_instrument_function, GA_IGNORE)
GA(noclone, GA_IGNORE)
GA(noinline, GA_IGNORE)
GA(nonnull, GA_IMPLEMENTED)
GA(nonstring, GA_IGNORE)
/* Ignoring noreturn is CONSERVATIVE: we merely fail to learn that a call
 * does not return, which costs flow-analysis precision and can produce a
 * spurious "control reaches end of non-void function". It cannot make a
 * correct program wrong. */
GA(noreturn, GA_IMPLEMENTED)
GA(nothrow, GA_IGNORE)
GA(pure, GA_IGNORE)
GA(sentinel, GA_IGNORE)
GA(unused, GA_IGNORE)
GA(warn_unused_result, GA_IMPLEMENTED)

/* --- implemented: the semantics are real ------------------------------- */
/* Intercepted by name in parse_cgf_attributes before the class is consulted;
 * the rows are here so this table remains the whole attribute surface. */
GA(alias, GA_IMPLEMENTED)
/* `used` keeps a symbol the IPO pass would otherwise delete. */
GA(used, GA_IMPLEMENTED)
GA(aligned, GA_IMPLEMENTED)
GA(cleanup, GA_IMPLEMENTED)
GA(constructor, GA_IMPLEMENTED)
GA(destructor, GA_IMPLEMENTED)
GA(gnu_inline, GA_IMPLEMENTED)
GA(mode, GA_IMPLEMENTED)
GA(may_alias, GA_IMPLEMENTED)
GA(packed, GA_IMPLEMENTED)
GA(section, GA_IMPLEMENTED)
GA(visibility, GA_IMPLEMENTED)
GA(weak, GA_IMPLEMENTED)

/* --- NOT safe to ignore: layout, linkage, or behaviour ------------------ */
/* returns_twice is the setjmp property: ignoring it lets the optimizer
 * assume single-entry, which is exactly the assumption setjmp breaks. */
GA(returns_twice, GA_UNSAFE)
/* transparent_union changes how the union is PASSED -- the first member's
 * convention rather than the union's. Ignoring it is an ABI mismatch, so it
 * is refused despite the sprint's initial parsed-ignored tiering; that tier
 * was assigned before this table asked the ignore-safety question. It does
 * not appear in musl. */
GA(transparent_union, GA_UNSAFE)
