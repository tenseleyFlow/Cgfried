mir.a64 @branch_zero (vregs=6)
bb1:
    mov.w v1, v2
    cbz.w v1, bb2, bb3
bb2:
    orr.w v4, wzr, #1
    mov.w v3, v4
    ret v3
bb3:
    movz.w v6, #0, #0
    mov.w v5, v6
    ret v5
mir.a64 @branch_nonzero (vregs=6)
bb1:
    mov.x v1, v2
    cbnz.x v1, bb2, bb3
bb2:
    orr.w v4, wzr, #1
    mov.w v3, v4
    ret v3
bb3:
    movz.w v6, #0, #0
    mov.w v5, v6
    ret v5
mir.a64 @branch_signed (vregs=8)
bb1:
    mov.w v1, v3
    mov.w v2, v4
    subs.w wzr, v1, v2
    b.lt bb2, bb3
bb2:
    orr.w v6, wzr, #7
    mov.w v5, v6
    ret v5
bb3:
    movz.w v8, #9, #0
    mov.w v7, v8
    ret v7
mir.a64 @branch_unsigned (vregs=8)
bb1:
    mov.x v1, v3
    mov.x v2, v4
    subs.x xzr, v1, v2
    b.hi bb2, bb3
bb2:
    orr.w v6, wzr, #7
    mov.w v5, v6
    ret v5
bb3:
    movz.w v8, #9, #0
    mov.w v7, v8
    ret v7
