mir.a64 @switch_dense (vregs=16)
bb1:
    mov.w v1, v2
    movn.w v3, #0, #0
    subs.w wzr, v1, v3
    b.eq bb2
    movz.w v4, #0, #0
    subs.w wzr, v1, v4
    b.eq bb3
    orr.w v5, wzr, #1
    subs.w wzr, v1, v5
    b.eq bb4
    orr.w v6, wzr, #2
    subs.w wzr, v1, v6
    b.eq bb5
    b bb6
bb2:
    movn.w v8, #0, #0
    mov.w v7, v8
    ret v7
bb3:
    movz.w v10, #10, #0
    mov.w v9, v10
    ret v9
bb4:
    movz.w v12, #11, #0
    mov.w v11, v12
