// F-S30-FWDSSA: def dominates use in the CFG but follows it in block layout.
// The Sprint 53 address planner may fold %q directly into the load even though
// its defining block follows the use in layout.  The base must still be %base;
// vreg 0 would mean [frame], which was the original regression.
// FLAGS: -O1 -emit-mir
// MIR_CHECK: = load.l [rdi+4]
// IR_CHECK-NOT: [frame]
func i32 @f(ptr %base) {
entry():
    %slot = alloca 8, align 8
    br def()
use():
    %p = load ptr, %slot, align 8
    %v = load i32, %p, align 4
    ret i32 %v
def():
    %q = ptradd %base, 4
    store ptr %q, %slot, align 8
    br use()
}
