// FLAGS: -O1
// IR_CHECK-NOT: alloca
// IR_CHECK-NOT: load
// IR_CHECK-NOT: store
func i32 @f(i32 %x) {
entry():
    %src = alloca 4, align 4
    %dst = alloca 4, align 4
    store i32 %x, %src, align 4
    %v = load i32, %src, align 4
    store i32 %v, %dst, align 4
    %r = load i32, %dst, align 4
    ret i32 %r
}
