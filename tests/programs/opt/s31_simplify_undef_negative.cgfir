// FLAGS: -O2
// Per-read undef freedom forbids reflexive folding and value duplication.
// IR_CHECK: isub i32
// IR_CHECK: sdiv i32
func i32 @f(i32 %c, i32 %x) {
entry():
    condbr %c, unknown(), defined()
unknown():
    br join(i32 undef)
defined():
    br join(i32 %x)
join(i32 %v):
    %same = isub i32 %v, %v
    %q = sdiv i32 %v, 8
    %r = iadd i32 %same, %q
    ret i32 %r
}
