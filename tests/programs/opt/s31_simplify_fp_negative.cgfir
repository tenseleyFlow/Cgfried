// FLAGS: -O2
// FP-NO rows must survive without Sprint 36 fast-math permission.
// IR_CHECK: fadd f64 %0, 0x0000000000000000
// IR_CHECK: fmul f64
// IR_CHECK: fsub f64
func f64 @f(f64 %x) {
entry():
    %a = fadd f64 %x, 0x0000000000000000
    %b = fmul f64 %a, 0x0000000000000000
    %c = fsub f64 %b, %b
    ret f64 %c
}
