// Verifier hardening pin: a block passing its OWN param on a backedge is
// legal (the param dominates the branch via the block head), including
// through a diamond.
// IR_CHECK: br loop(i32 %1, i32 %2)
func void @f(i32 %c) {
entry():
    br loop(i32 0, i32 1)
loop(i32 %i, i32 %k):
    condbr %c, a(), b()
a():
    br loop(i32 %i, i32 %k)
b():
    ret
}
