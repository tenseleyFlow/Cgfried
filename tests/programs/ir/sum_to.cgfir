// IR_CHECK: func i32 @sum_to(i32 %0)
// IR_CHECK: br loop(i32 0, i32 0)
// IR_CHECK: %3 = icmp slt i32 %1, %0
// IR_CHECK: condbr %3, body(), done(i32 %2)
// IR_CHECK: ret i32 %6
func i32 @sum_to(i32 %n) {
entry():
    br loop(i32 0, i32 0)
loop(i32 %i, i32 %acc):
    %c = icmp slt i32 %i, %n
    condbr %c, body(), done(i32 %acc)
body():
    %acc2 = iadd i32 %acc, %i
    %i2 = iadd i32 %i, 1
    br loop(i32 %i2, i32 %acc2)
done(i32 %r):
    ret i32 %r
}
