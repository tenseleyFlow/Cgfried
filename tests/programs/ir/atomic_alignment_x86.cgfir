// IR-C-11: the verifier contract must reject under-aligned scalar atomics
// before x86 instruction selection relies on indivisible machine accesses.
// FLAGS: --target=x86_64-linux-gnu -emit-ir
// ERROR_EXPECTED: requires natural alignment
func void @atomic_alignment_x86(ptr %p, f64 %d) {
entry():
    %f = load f32, %p, align 1, seq_cst
    store f64 %d, %p, align 1, seq_cst
    %i = load i64, %p, align 1, seq_cst
    store i32 0, %p, align 2, seq_cst
    %q = load ptr, %p, align 4, seq_cst
    store ptr %q, %p, align 4, seq_cst
    ret
}
