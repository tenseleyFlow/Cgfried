// Loops, conditional branches, and a switch — the shapes where the
// branch relaxer and the block-parameter copies have to agree.
func i64 @sumto(i64 %n) {
entry():
    br loop(i64 0, i64 0)
loop(i64 %i, i64 %acc):
    %done = icmp sge i64 %i, %n
    condbr %done, out(i64 %acc), body()
body():
    %ni = iadd i64 %i, 1
    %na = iadd i64 %acc, %i
    br loop(i64 %ni, i64 %na)
out(i64 %r):
    ret i64 %r
}

func i32 @classify(i32 %x) {
entry():
    switch i32 %x, other(), -1: neg(), 0: zero(), 1: one(), 2: two(), 3: three()
neg():
    ret i32 -100
zero():
    ret i32 10
one():
    ret i32 11
two():
    ret i32 12
three():
    ret i32 13
other():
    ret i32 99
}

func i64 @nested(i64 %a, i64 %b) {
entry():
    %c = icmp slt i64 %a, %b
    condbr %c, less(), more()
less():
    %d = icmp slt i64 %a, 0
    condbr %d, negsmall(), possmall()
more():
    %s = isub i64 %a, %b
    ret i64 %s
negsmall():
    ret i64 -1
possmall():
    ret i64 1
}
